<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_shipment_list" model="ir.ui.view">
        <field name="name">logistics.shipment.list</field>
        <field name="model">logistics.shipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="entry_date"/>
                <field name="exit_date"/>
                <field name="quantity"/>
                <field name="cbm"/>
                <field name="storage_days"/>
                <field name="storage_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_shipment_form" model="ir.ui.view">
        <field name="name">logistics.shipment.form</field>
        <field name="model">logistics.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipment">
                <header>
                    <button name="action_set_stored" type="object" string="Set Stored" invisible="state != 'draft'"/>
                    <button name="action_set_outbound" type="object" string="Set Outbound" invisible="state != 'stored'"/>
                    <button name="action_set_done" type="object" string="Set Done" invisible="state != 'outbound'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="entry_date"/>
                            <field name="exit_date"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="cbm"/>
                            <field name="storage_rate"/>
                            <field name="storage_days" readonly="1"/>
                            <field name="storage_amount" readonly="1"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Operational notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_logistics_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">logistics.shipment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
