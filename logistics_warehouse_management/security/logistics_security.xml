<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_logistics_user" model="res.groups">
        <field name="name">Logistics User</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_logistics_manager" model="res.groups">
        <field name="name">Logistics Manager</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('group_logistics_user'))]"/>
    </record>

    <record id="logistics_shipment_company_rule" model="ir.rule">
        <field name="name">Logistics Shipment: multi-company</field>
        <field name="model_id" ref="model_logistics_shipment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_logistics_user'))]"/>
    </record>
</odoo>
